<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="parchment"
        Arguments=""
        InstallLocation="C:\Program Files\incurl\Parchment">
    </Installer>
    <PackageInformation
        PackageName="Parchment"
        PackageDisplayName="Parchment"
        PublisherName="CN=incurl"
        PublisherDisplayName="incurl"
        Version="0.1.0.0"
        PackageDescription="A Wails v3 desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.incurl.parchment"
                Description="A Wails v3 desktop application"
                DisplayName="Parchment"
                ExecutableName="parchment"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Parchment</DisplayName>
            <PublisherDisplayName>incurl</PublisherDisplayName>
            <Description>A Wails v3 desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="parchment.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
